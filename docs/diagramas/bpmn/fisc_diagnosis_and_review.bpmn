<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="FISC_Diagnosis_Review" targetNamespace="urn:fisc:bpmn">
  <collaboration id="Collab_Diagnosis"><participant id="Pool_FISC" name="FISC" processRef="Process_Diagnosis"/><participant id="Pool_Human" name="Analista/Especialista fiscal" processRef="Process_Diagnosis"/></collaboration>
  <process id="Process_Diagnosis" name="Diagnóstico, triagem e revisão" isExecutable="false">
    <startEvent id="Start_Diagnosis" name="Solicitação aceita"/><task id="Task_Context" name="Validar IncidentRequest e FiscalContext"/><task id="Task_XML" name="Preservar bytes/hash e analisar XML"/><exclusiveGateway id="Gateway_XML" name="XML analisável?"/><task id="Task_XSD" name="Validar XSD, chave, cStat, protocolo e XMLDSig"/><task id="Task_Gap" name="Registrar G-xml/G-kb/G-events"/><task id="Task_Correlation" name="Correlacionar timeout e duplicidade"/><task id="Task_KB" name="Consultar dfe_kb com fonte e vigência"/><task id="Task_LLM" name="Gerar hipótese e relatório"/><exclusiveGateway id="Gateway_Review" name="Revisão necessária?"/><task id="Task_Review" name="Aprovar, editar ou rejeitar checkpoint"/><task id="Task_Escalate" name="Escalonar ao especialista"/><task id="Task_Close" name="Encerrar com evidências e decisão"/><endEvent id="End_Done" name="Incidente encerrado"/>
    <sequenceFlow id="d1" sourceRef="Start_Diagnosis" targetRef="Task_Context"/><sequenceFlow id="d2" sourceRef="Task_Context" targetRef="Task_XML"/><sequenceFlow id="d3" sourceRef="Task_XML" targetRef="Gateway_XML"/><sequenceFlow id="d4" sourceRef="Gateway_XML" targetRef="Task_Gap" name="não"/><sequenceFlow id="d5" sourceRef="Gateway_XML" targetRef="Task_XSD" name="sim"/><sequenceFlow id="d6" sourceRef="Task_XSD" targetRef="Task_Correlation"/><sequenceFlow id="d7" sourceRef="Task_Gap" targetRef="Task_Correlation"/><sequenceFlow id="d8" sourceRef="Task_Correlation" targetRef="Task_KB"/><sequenceFlow id="d9" sourceRef="Task_KB" targetRef="Task_LLM"/><sequenceFlow id="d10" sourceRef="Task_LLM" targetRef="Gateway_Review"/><sequenceFlow id="d11" sourceRef="Gateway_Review" targetRef="Task_Review" name="sim + checkpoint"/><sequenceFlow id="d12" sourceRef="Gateway_Review" targetRef="Task_Escalate" name="sim, sem retomada"/><sequenceFlow id="d13" sourceRef="Gateway_Review" targetRef="Task_Close" name="não"/><sequenceFlow id="d14" sourceRef="Task_Review" targetRef="Task_Close"/><sequenceFlow id="d15" sourceRef="Task_Escalate" targetRef="Task_Close"/><sequenceFlow id="d16" sourceRef="Task_Close" targetRef="End_Done"/>
  </process>
</definitions>
