<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="FISC_Governance_Security" targetNamespace="urn:fisc:bpmn">
  <collaboration id="Collab_Governance"><participant id="Pool_Ops" name="Operação/Security/Fiscal" processRef="Process_Governance"/><participant id="Pool_FISC" name="FISC" processRef="Process_Governance"/></collaboration>
  <process id="Process_Governance" name="Governança, mudança e segurança" isExecutable="false">
    <startEvent id="Start_Gov" name="Mudança, fonte nova ou incidente de segurança"/><exclusiveGateway id="Gateway_Type" name="Tipo de ocorrência?"/><task id="Task_Dep" name="Verificar health/ready e dependências"/><task id="Task_Change" name="Versionar regra, fonte, vigência e testes"/><task id="Task_Security" name="Revogar/rotacionar segredo e preservar error_id"/><task id="Task_Review" name="Revisar risco, controle e aprovação"/><task id="Task_Rollback" name="Executar rollback versionado"/><task id="Task_Audit" name="Registrar evidências e retenção"/><endEvent id="End_Gov" name="Controle concluído"/>
    <sequenceFlow id="g1" sourceRef="Start_Gov" targetRef="Gateway_Type"/><sequenceFlow id="g2" sourceRef="Gateway_Type" targetRef="Task_Dep" name="indisponibilidade"/><sequenceFlow id="g3" sourceRef="Gateway_Type" targetRef="Task_Change" name="regra/fonte"/><sequenceFlow id="g4" sourceRef="Gateway_Type" targetRef="Task_Security" name="segurança"/><sequenceFlow id="g5" sourceRef="Task_Dep" targetRef="Task_Audit"/><sequenceFlow id="g6" sourceRef="Task_Change" targetRef="Task_Review"/><sequenceFlow id="g7" sourceRef="Task_Security" targetRef="Task_Review"/><sequenceFlow id="g8" sourceRef="Task_Review" targetRef="Task_Rollback" name="reprovar ou restaurar"/><sequenceFlow id="g9" sourceRef="Task_Review" targetRef="Task_Audit" name="aprovar"/><sequenceFlow id="g10" sourceRef="Task_Rollback" targetRef="Task_Audit"/><sequenceFlow id="g11" sourceRef="Task_Audit" targetRef="End_Gov"/>
  </process>
</definitions>
